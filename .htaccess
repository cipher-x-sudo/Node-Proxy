<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Proxy all non-static requests
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2|woff|ttf|map)$ [NC]
    RewriteRule ^(.*)$ index.php [QSA,L]
    
    # Proxy static assets through rewrite
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z0-9-]+)-hailuoai-video/(.*)$ index.php [QSA,L]
</IfModule>

Options -Indexes

<IfModule mod_headers.c>
    Header unset Server
    Header always unset X-Powered-By
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "default-src 'self' https://hailuo.anon404.me 'unsafe-inline' 'unsafe-eval'; script-src 'self' https://hailuo.anon404.me https://cdn.hailuoai.video https://accounts.google.com https://www.googletagmanager.com https://relay-event.talkie-ai.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://hailuo.anon404.me https://cdn.hailuoai.video 'unsafe-inline'; font-src 'self' https://hailuo.anon404.me https://cdn.hailuoai.video; connect-src 'self' https://hailuo.anon404.me https://cdn.hailuoai.video https://relay-event.talkie-ai.com; img-src 'self' https://hailuo.anon404.me https://cdn.hailuoai.video data:;"
    Header unset Content-Encoding
</IfModule>

RewriteCond %{HTTP_REFERER} !^http://anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^http://hailuo.anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://hailuo.anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.hailuo.anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.hailuo.anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^https://anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^https://hailuo.anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://hailuo.anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.anon404.me$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.hailuo.anon404.me/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^https://www.hailuo.anon404.me$      [NC]
RewriteRule .*\.(jpg|jpeg|gif|png|bmp)$ - [F,NC]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
